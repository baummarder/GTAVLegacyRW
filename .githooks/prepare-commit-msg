#!/bin/sh
#
# prepare-commit-msg hook: adds the project co-authors to every commit.
#
# Installed via:
#     git config core.hooksPath .githooks
#
# Written for the GTA V Legacy project, which is developed with AI assistance.
# Delete this hook if you do not want the trailers.

msg_file="$1"
msg_source="${2:-}"

# Nothing to do for autogenerated messages we should not touch.
case "$msg_source" in
    merge|squash) exit 0 ;;
esac

[ -s "$msg_file" ] || exit 0

# Skip empty messages (aborted commits, template only).
grep -q '[^[:space:]]' "$msg_file" || exit 0

# Skip fixup/squash commits created by rebase.
case "$(head -n 1 "$msg_file")" in
    "fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

# Never add the trailers twice (e.g. on --amend).
if grep -qi '^Co-authored-by: DeepSeek' "$msg_file"; then
    exit 0
fi

printf '\nCo-authored-by: DeepSeek V4.1 Flash <noreply@deepseek.com>\nCo-authored-by: OpenCode <noreply@opencode.ai>\n' >> "$msg_file"
